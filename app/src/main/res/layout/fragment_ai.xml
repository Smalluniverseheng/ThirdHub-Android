<?xml version="1.0" encoding="utf-8"?>
<!-- AI 对话页：aiBeta 顶栏 + OmniHub 欢迎区 + 左侧会话抽屉（跟手平滑） -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aiDrawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/th_bg">

    <!-- 主内容 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶栏：☰ | 模型胶囊 | ＋新会话 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btnDrawer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_menu"
                android:contentDescription="会话列表" />

            <LinearLayout
                android:id="@+id/modelPill"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/bg_model_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/pillIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp" />

                <TextView
                    android:id="@+id/pillLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="选择模型"
                    android:textColor="@color/th_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="▾"
                    android:textColor="@color/th_text3"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNewChatTop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_add_box"
                android:contentDescription="新会话" />
        </LinearLayout>

        <!-- 内容区：消息列表 / 欢迎页 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/msgScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/msgList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </ScrollView>

            <!-- 欢迎区（OmniHub 式：大图标 + 问候 + 推荐） -->
            <ScrollView
                android:id="@+id/welcomeScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="28dp">

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginTop="26dp"
                        android:background="@drawable/bg_brand_large"
                        android:elevation="6dp">

                        <ImageView
                            android:id="@+id/welcomeIcon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center" />

                        <TextView
                            android:id="@+id/welcomeLetter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/welcomeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="你好，我是 AI 助手"
                        android:textColor="@color/th_text"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/welcomeDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.5"
                        android:textColor="@color/th_text2"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/welcomeChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:textColor="@color/th_text2"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:layout_marginBottom="10dp"
                        android:text="今日推荐"
                        android:textColor="@color/th_text3"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/sug1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_suggestion"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp"
                        android:text="帮我写一封礼貌的请假邮件"
                        android:textColor="@color/th_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/sug2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_suggestion"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp"
                        android:text="用简单的话解释一个复杂概念"
                        android:textColor="@color/th_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/sug3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_suggestion"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp"
                        android:text="给我制定一份三天学习计划"
                        android:textColor="@color/th_text"
                        android:textSize="14sp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- 输入区（aiBeta 胶囊输入条） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_pill_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/btnPlus"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_btn_circle"
                android:src="@drawable/ic_add"
                android:contentDescription="更多功能" />

            <EditText
                android:id="@+id/inputMsg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:hint="问点什么…"
                android:imeOptions="actionSend"
                android:maxLines="4"
                android:minHeight="38dp"
                android:textColor="@color/th_text"
                android:textColorHint="@color/th_text3"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_send_circle"
                android:src="@drawable/ic_send"
                android:contentDescription="发送" />
        </LinearLayout>
    </LinearLayout>

    <!-- 左侧会话抽屉（右滑手势呼出） -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/th_card"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="会话记录"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/th_text" />

        <Button
            android:id="@+id/btnNewChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="＋ 新会话" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:id="@+id/sessionList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="从左边缘向右滑可打开本面板"
            android:textSize="11sp"
            android:textColor="@color/th_text3" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
